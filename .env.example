# Copy to .env.local, or set in Vercel's project settings. Everything is optional.

# Postgres connection string (Supabase, Neon or any Postgres 13+).
# Unset -> embedded Postgres (PGlite) in DATA_DIR, or /tmp on Vercel (resets on cold starts).
# DATABASE_URL=postgres://user:password@host:6543/postgres
# DATABASE_SSL=true
# DATABASE_POOL_MAX=5

# Where the embedded database lives when DATABASE_URL is unset (default: ./.data)
# DATA_DIR=.data

# Any MapLibre style URL (default: OpenFreeMap Liberty)
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
