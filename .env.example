# Copy to .env.local and fill in what you need. Everything is optional.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Unset            -> local mode: no server needed, dogs come from src/data/dogs.json,
#                     likes/photos/reports are saved in each visitor's browser only.
# /api             -> use the reference backend bundled in this app (JSON file on disk).
# https://...      -> your own backend implementing docs/API.md.
NEXT_PUBLIC_API_URL=

# Reference backend only (server-side, never exposed to the browser)
ADMIN_TOKEN=
# DOGMAP_DB_FILE=.data/db.json

# ---------------------------------------------------------------------------
# Feature switches (true/false). Defaults shown.
# ---------------------------------------------------------------------------
# Sightings need a shared backend to be useful, so they start off.
NEXT_PUBLIC_FEATURE_SIGHTINGS=false
# Hangout zones are built from sightings, so they only appear when sightings are on.
NEXT_PUBLIC_FEATURE_HANGOUTS=true
NEXT_PUBLIC_FEATURE_SUBMISSIONS=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_LIKES=true
NEXT_PUBLIC_FEATURE_PHOTO_WALL=true
NEXT_PUBLIC_FEATURE_COLLECTION=true
NEXT_PUBLIC_FEATURE_NEARBY=true
NEXT_PUBLIC_FEATURE_CLUSTERING=true
NEXT_PUBLIC_FEATURE_LANDMARKS=true

# ---------------------------------------------------------------------------
# Campus settings
# ---------------------------------------------------------------------------
# esri (free satellite + OSM streets, default) | osm | google
NEXT_PUBLIC_TILE_PROVIDER=esri
# Reports are emailed here in local mode. Leave empty to hide the email step.
NEXT_PUBLIC_WELFARE_EMAIL=
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_VOLUNTEER_URL=
# Pin a dog id as "Dog of the week" (otherwise it rotates weekly)
NEXT_PUBLIC_FEATURED_DOG_ID=
